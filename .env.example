ENVIRONMENT=development

SQL_SERVER=localhost
SQL_DATABASE=brokersync
SQL_USER=brokersync_admin
SQL_PASSWORD=BrokerSync-2024-Secure_DevPass123
SQL_SSL_MODE=require

# Connection pool + query-safety timeouts (see app/core/config.py). Defaults
# are sane for a db.t3.micro; override only to tune. DB_POOL_TIMEOUT is
# deliberately below the desktop client's 15s read timeout so a saturated
# pool fails fast. DB_STATEMENT_TIMEOUT_MS / DB_IDLE_IN_TRANSACTION_TIMEOUT_MS
# are enforced by Postgres and stop one stuck query/transaction from
# starving the whole pool.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=10
# DB_POOL_RECYCLE=1800
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

JWT_SECRET=62726f6b657273796e632d6465762d7365637265742d6b65793332
JWT_ACCESS_EXPIRY_MINUTES=30
JWT_REFRESH_EXPIRY_DAYS=7

CORS_ORIGINS=http://localhost:5173

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
# Gmail requires a 16-character App Password (myaccount.google.com/apppasswords) —
# a regular account password will not authenticate over SMTP.
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=
SMTP_FROM_NAME=Broker Sync

# Equal Solution (eqldata) vendor account — powers Inception > Data & Settings'
# "Fetch from Equal Solution" button (app/services/inception_vendor_sync_service.py).
# Optional: leave blank to disable that button server-side (it'll return a clear
# error) rather than requiring every environment to have vendor access configured.
EQLDATA_EMAIL=
EQLDATA_PASSWORD=
EQLDATA_BASE_URL=https://api.equalsolution.net
