{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeChatModels",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/anthropic.*",
        "arn:aws:bedrock:*:631069968633:inference-profile/*anthropic.*",
        "arn:aws:bedrock:*::foundation-model/amazon.nova-*",
        "arn:aws:bedrock:*:631069968633:inference-profile/*amazon.nova-*"
      ]
    },
    {
      "Sid": "ApplyChatGuardrail",
      "Effect": "Allow",
      "Action": "bedrock:ApplyGuardrail",
      "Resource": "arn:aws:bedrock:ap-south-1:631069968633:guardrail/8y32pjfflzq6"
    },
    {
      "Sid": "MarketplaceSubscribe",
      "Effect": "Allow",
      "Action": [
        "aws-marketplace:ViewSubscriptions",
        "aws-marketplace:Subscribe"
      ],
      "Resource": "*"
    }
  ]
}
